# ─── Language Guru admin panel ──────────────────────────────────────────────
# Copy this file to .env.local (git-ignored) and fill in the values.
# `npm run dev` and `npm run build` both refuse to start if these are missing.

# Where the browser reaches the API. Required, no fallback.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: set only when the server reaches the API on a different internal host.
# API_URL=http://api:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
